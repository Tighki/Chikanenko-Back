# PostgreSQL на этой же машине. Порт 5432 наружу не открывать.
DATABASE_URL=postgresql://hostel:hostel@127.0.0.1:5432/hostel
JWT_SECRET=change-me-before-defense

# Слушать все интерфейсы, иначе проброс с роутера не дойдёт до процесса.
HOST=0.0.0.0
PORT=4000

# Адрес, с которого в браузере открыт фронт. Несколько адресов через запятую.
# Пустое значение или * — принимать запросы с любого адреса.
CORS_ORIGIN=http://SERVER:5173
